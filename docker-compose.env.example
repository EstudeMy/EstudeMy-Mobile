# ==============================================================================
# Configuração de Ambiente para Docker Compose - EstudeMy Mobile & Backend
# ==============================================================================
# Para customizar os valores, crie uma cópia deste arquivo chamada '.env.compose'
# ou defina as variáveis no seu ambiente e rode:
#   docker compose --env-file .env.compose up --build
# ==============================================================================

# Porta e URL da API Backend
PORT=5000
BACKEND_URL=http://localhost:5000

# Porta do aplicativo Mobile Web (Nginx)
MOBILE_PORT=8081

# URL da API consumida pelo aplicativo mobile
# - Para acesso web no navegador: http://localhost:5000
# - Para emulador Android no host: http://10.0.2.2:5000
# - Para dispositivo físico na rede local: http://<IP_DO_SEU_PC>:5000
# - Para API em produção no Render: https://estudemydocker.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:5000

# Segredo de Assinatura dos Tokens JWT (Obrigatório em produção)
JWT_SECRET=estudemy_super_secret_jwt_key_2026_dev

# Conexão com MongoDB (Dentro da rede Docker, o host é 'mongo')
MONGO_URI=mongodb://mongo:27017/estudemy

# Conexão com Banco Relacional SQL de Emergência / Backup (PostgreSQL 16)
POSTGRES_PORT=5432
POSTGRES_DB=estudemy_emergencia
POSTGRES_USER=estudemy_admin
POSTGRES_PASSWORD=estudemy_sql_secure_pass_2026
POSTGRES_APP_USER=estudemy_app
POSTGRES_APP_PASSWORD=estudemy_app_secure_pass_2026
POSTGRES_URI=postgresql://estudemy_app:estudemy_app_secure_pass_2026@postgres:5432/estudemy_emergencia
EMERGENCY_DB_ENABLED=true

# Origem permitida no CORS do Backend
FRONTEND_URL=http://localhost:8081

# Monitoramento de Logs (Opcional - Better Stack)
# BETTER_STACK_SOURCE_TOKEN=
# BETTER_STACK_SERVICE_NAME=estudemy-backend
# BETTER_STACK_INGEST_URL=


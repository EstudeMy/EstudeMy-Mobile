# URL da API do backend EstudeMy
# - Desenvolvimento local com Docker / Localhost:
# EXPO_PUBLIC_API_URL=http://localhost:5000
#
# - Desenvolvimento com Emulador Android:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
#
# - Produção na Nuvem (Render):
EXPO_PUBLIC_API_URL=https://estudemydocker.onrender.com

# ==============================================================================
# EstudeMy - Variáveis de Ambiente de Produção em Nuvem (.env.production)
# ==============================================================================
# Instruções: Copie este arquivo para '.env' no servidor em nuvem (/opt/estudemy/.env)
# e preencha com credenciais seguras e tokens de produção.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações de Domínio e Rede Externa (Subnet DMZ)
# ------------------------------------------------------------------------------
DOMAIN=estudemy.site
FRONTEND_URL=https://estudemy.site
BACKEND_URL=https://api.estudemy.site
EXPO_PUBLIC_API_URL=https://api.estudemy.site

# ------------------------------------------------------------------------------
# 2. Credenciais de Banco de Dados - MongoDB 7.0 (Subnet Privada)
# ------------------------------------------------------------------------------
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=alterar_para_senha_root_ultra_segura_2026
MONGO_DATABASE=estudemy
MONGO_APP_USER=estudemy_app
MONGO_APP_PASSWORD=alterar_para_senha_app_ultra_segura_2026

# URI de Conexão interna utilizada pelo backend (isolada na estudemy_net)
MONGO_URI=mongodb://estudemy_app:alterar_para_senha_app_ultra_segura_2026@mongo:27017/estudemy?authSource=admin

# ------------------------------------------------------------------------------
# 3. Segurança e Assinatura Criptográfica (JWT)
# ------------------------------------------------------------------------------
# Chave de alta entropia para assinatura de tokens (mínimo 64 caracteres hex)
JWT_SECRET=sua_chave_secreta_jwt_producao_estudemy_super_segura_token_2026

# ------------------------------------------------------------------------------
# 4. Observabilidade e Monitoramento (Better Stack + Grafana)
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=alterar_para_senha_grafana_2026
BETTER_STACK_SOURCE_TOKEN=
BETTER_STACK_SERVICE_NAME=estudemy-cloud-production
BETTER_STACK_INGEST_URL=https://in.logs.betterstack.com

# ------------------------------------------------------------------------------
# 5. Armazenamento de Objetos & Backups (OCI Object Storage / AWS S3)
# ------------------------------------------------------------------------------
OBJECT_STORAGE_PROVIDER=oci # oci | aws | local
OBJECT_STORAGE_BUCKET=estudemy-backups
OBJECT_STORAGE_NAMESPACE=
OCI_REGION=sa-saopaulo-1
# Para AWS S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=sa-east-1
